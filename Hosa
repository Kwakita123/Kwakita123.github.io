    def build_quiz_tab(self):
        canvas = tk.Canvas(self.tab_quiz, borderwidth=0, highlightthickness=0)
        scrollbar = ttk.Scrollbar(self.tab_quiz, orient="vertical", command=canvas.yview)
        self.quiz_container = ttk.Frame(canvas, padding=15)
        
        self.quiz_container.bind("<Configure>", lambda e: canvas.configure(scrollregion=canvas.bbox("all")))
        canvas.create_window((0, 0), window=self.quiz_container, anchor="nw")
        canvas.configure(yscrollcommand=scrollbar.set)
        canvas.pack(side="left", fill="both", expand=True)
        scrollbar.pack(side="right", fill="y")
        
        top_lbl = tk.Label(self.quiz_container, text="NATIONAL COMPREHENSIVE 50-QUESTION BOARD CALCULUS PRACTICE MATRIX", font=("Arial", 12, "bold"), fg="#003366")
        top_lbl.pack(pady=(0, 10))
        self.translatable_labels.append(top_lbl)
        
        self.question_bank = []
        for i in range(1, 51):
            mod = i % 5
            q_id = f"q{i}"
            if mod == 1:
                v_mg = 10 * i
                self.question_bank.append({
                    "id": q_id, "label": f"Q{i}: Metric Microgram Translation",
                    "text": f"An order requires {v_mg} milligrams of a critical heart stabilizer. Convert this to micrograms.",
                    "options": [(f"{v_mg * 10} mcg", "A"), (f"{v_mg * 1000} mcg", "B"), (f"{v_mg / 1000} mcg", "C"), (f"{v_mg * 10} mcg", "D")], "ans": "B",
                    "why": f"To convert from milligrams to micrograms, you multiply by 1,000 because each milligram contains 1,000 smaller microgram units."
                })
            elif mod == 2:
                v_tsp = 3 + (i // 5)
                self.question_bank.append({
                    "id": q_id, "label": f"Q{i}: Outpatient Liquid Reconciliation",
                    "text": f"A pediatric liquid prescription instructs the parent to administer {v_tsp} teaspoons of antibiotic suspension. Convert this to standard mL.",
                    "options": [(f"{v_tsp * 5} mL", "A"), (f"{v_tsp * 15} mL", "B"), (f"{v_tsp * 30} mL", "C"), (f"{v_tsp * 3} mL", "D")], "ans": "A",
                    "why": f"1 standard household teaspoon is accepted globally to hold exactly 5 mL in outpatient care."
                })
            elif mod == 3:
                v_gr = 2 + (i // 10)
                self.question_bank.append({
                    "id": q_id, "label": f"Q{i}: Legacy Apothecary Compounding",
                    "text": f"A prescription calls for gr {v_gr} of an ancient sedating extract. Calculate the equivalent Modern Milligram metric.",
                    "options": [(f"{v_gr * 15} mg", "A"), (f"{v_gr * 5} mg", "B"), (f"{v_gr * 60} mg", "C"), (f"{v_gr / 60} mg", "D")], "ans": "C",
                    "why": f"Under historical apothecary standards, 1 grain is equivalent to 60 milligrams."
                })
            elif mod == 4:
                v_ml = 100 + (i * 5)
                self.question_bank.append({
                    "id": q_id, "label": f"Q{i}: Continuous Infusion Volumetric Velocity",
                    "text": f"Infuse a solution of {v_ml} mL over exactly 4 hours. What is the required volumetric hourly pump rate configuration?",
                    "options": [(f"{v_ml} mL/hr", "A"), (f"{round(v_ml / 4, 1)} mL/hr", "B"), (f"{v_ml * 4} mL/hr", "C"), (f"{round(v_ml / 2, 1)} mL/hr", "D")], "ans": "B",
                    "why": f"Electronic smart pumps require a clean volume entry calibrated strictly per hour. Divide total volume by hours."
                })
            else:
                v_w = 40 + i
                self.question_bank.append({
                    "id": q_id, "label": f"Q{i}: Weight Metric Alignment",
                    "text": f"A patient weighs {v_w} lbs. Convert this mass metric into kilograms for standard weight-based medical calculations.",
                    "options": [(f"{round(v_w * 2.2, 1)} kg", "A"), (f"{round(v_w / 2.2, 2)} kg", "B"), (f"{v_w} kg", "C"), (f"{v_w + 10} kg", "D")], "ans": "B",
                    "why": f"1 kilogram is equal to 2.2 pounds. When converting pounds to kilograms, divide by 2.2."
                })

        for q in self.question_bank:
            lbl = tk.Label(self.quiz_container, text=q["label"], font=("Arial", 9, "bold"), fg="#003366")
            lbl.pack(anchor="w", pady=(8, 1))
            txt_lbl = tk.Label(self.quiz_container, text=q["text"], justify="left", font=("Arial", 9))
            txt_lbl.pack(anchor="w", pady=(0, 2))
            self.translatable_labels.extend([lbl, txt_lbl])
            
            feedback_lbl = tk.Label(self.quiz_container, text="Select an option to evaluate the clinical rationale...", font=("Arial", 9, "italic"), fg="gray")
            v = tk.StringVar(value="None")
            for txt, choice in q["options"]:
                r_btn = ttk.Radiobutton(self.quiz_container, text=txt, variable=v, value=choice, command=lambda q_ref=q, var_ref=v, f_lbl=feedback_lbl: self.evaluate_choice(q_ref, var_ref, f_lbl))
                r_btn.pack(anchor="w", padx=10)
                
            feedback_lbl.pack(anchor="w", pady=(2, 6))
            ttk.Separator(self.quiz_container, orient="horizontal").pack(fill="x", pady=4)

    def evaluate_choice(self, question, var, lbl):
        user_selection = var.get()
        if user_selection == question["ans"]:
            lbl.config(text=f"🎯 CORRECT!\nWHY IT IS SOLVED THIS WAY: {question['why']}", fg="green", font=("Arial", 9, "bold"), justify="left", wraplength=1150)
        else:
            lbl.config(text=f"❌ INCORRECT (Selected {user_selection})\nWHY IT IS SOLVED THIS WAY: {question['why']}", fg="#cc0000", font=("Arial", 9, "bold"), justify="left", wraplength=1150)

    def build_tools_tab(self):
        canvas = tk.Canvas(self.tab_tools, borderwidth=0, highlightthickness=0)
        scrollbar = ttk.Scrollbar(self.tab_tools, orient="vertical", command=canvas.yview)
        container = ttk.Frame(canvas, padding=20)
        
        container.bind("<Configure>", lambda e: canvas.configure(scrollregion=canvas.bbox("all")))
