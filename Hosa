    def __init__(self, root):
        self.root = root
        self.root.title("HOSA Medical Math National Elite Training Suite")
        self.root.geometry("1350x980")
        
        self.style = ttk.Style()
        self.style.theme_use("clam")
        self.style.configure("TNotebook.Tab", font=("Arial", 10, "bold"), padding=[10, 5])
        self.style.configure("TButton", font=("Arial", 9, "bold"))
        
        self.translatable_labels = [] 
        self.build_translation_bar()
        
        self.notebook = ttk.Notebook(self.root)
        self.notebook.pack(pady=5, expand=True, fill="both")
        
        self.tab_textbook = ttk.Frame(self.notebook)
        self.tab_quiz = ttk.Frame(self.notebook)
        self.tab_tools = ttk.Frame(self.notebook)
        
        self.notebook.add(self.tab_textbook, text=" 📖 Advanced Curriculum & Visual Schematics ")
        self.notebook.add(self.tab_quiz, text=" 📋 50-Question Explanatory Board Exam ")
        self.notebook.add(self.tab_tools, text=" 🧮 10 Master Clinical Simulators ")
        
        self.build_textbook_tab()
        self.build_quiz_tab()
        self.build_tools_tab()

    def build_translation_bar(self):
        trans_frame = ttk.Frame(self.root, padding=5)
        trans_frame.pack(fill="x", side="top")
        lbl = tk.Label(trans_frame, text="🌐 Native Translate Engine:", font=("Arial", 9, "bold"), fg="#003366")
        lbl.pack(side="left", padx=5)
        
        lang_options = sorted(list(LANGUAGES_ISO.keys()))
        self.lang_var = tk.StringVar(value="English")
        self.lang_combo = ttk.Combobox(trans_frame, textvariable=self.lang_var, values=lang_options, state="readonly", width=25)
        self.lang_combo.pack(side="left", padx=5)
        
        btn = ttk.Button(trans_frame, text="Translate Entire UI", command=self.trigger_translation)
        btn.pack(side="left", padx=5)

    def trigger_translation(self):
        target_lang_name = self.lang_var.get()
        target_code = LANGUAGES_ISO.get(target_lang_name, "en")
        messagebox.showinfo("Translation Engine", f"Translating components into {target_lang_name}. Please wait...")
        
        for widget in self.translatable_labels:
            if widget.winfo_exists():
                try:
                    current_text = widget.cget("text")
                    if current_text and not any(current_text.startswith(x) for x in ["Result:", "🎯", "❌", "⚠️", "Output:", "Diagnostic:"]):
                        url = f"https://translate.googleapis.com/translate_a/single?client=gtx&sl=auto&tl={target_code}&dt=t&q=" + urllib.parse.quote(current_text)
                        req = urllib.request.Request(url, headers={'User-Agent': 'Mozilla/5.0'})
                        with urllib.request.urlopen(req) as response:
                            data = json.loads(response.read().decode())
                            translated_text = "".join([sentence[0] for sentence in data[0] if sentence[0]])
                            widget.config(text=translated_text)
                except Exception:
                    continue
        messagebox.showinfo("Success", "Translation cycle completed successfully.")

