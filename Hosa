            lbl = tk.Label(f, text=label_text, font=("Arial", 9), width=45, anchor="w")
            lbl.pack(side="left")
            self.translatable_labels.append(lbl)
            ent = ttk.Entry(f, width=12)
            ent.pack(side="left", padx=5)
            u_lbl = tk.Label(f, text=unit_text, font=("Arial", 9, "italic"), width=12, anchor="w")
            u_lbl.pack(side="left")
            return ent

        # 1. basic mg to mcg
        tk.Label(container, text="1. Milligrams (mg) to Micrograms (mcg) Converter", font=("Arial", 10, "bold"), fg="#003366").pack(anchor="w", pady=(10, 2))
        self.t1_input = create_simple_field(container, "Enter Value:", "mg")
        self.t1_res = tk.Label(container, text="Result: --", font=("Arial", 9, "bold"), fg="gray"); self.t1_res.pack(anchor="w")
        ttk.Button(container, text="Convert to mcg", command=lambda: self.run_simplified_tool(1)).pack(anchor="w", pady=2)

        # 2. basic mL/hr
        tk.Label(container, text="2. Basic IV Flow Rate Calculator (mL/hr)", font=("Arial", 10, "bold"), fg="#003366").pack(anchor="w", pady=(10, 2))
        self.t2_vol = create_simple_field(container, "Total Volume Ordered:", "mL")
        self.t2_time = create_simple_field(container, "Total Time Window:", "Hours")
        self.t2_res = tk.Label(container, text="Result: --", font=("Arial", 9, "bold"), fg="gray"); self.t2_res.pack(anchor="w")
        ttk.Button(container, text="Calculate mL/hr", command=lambda: self.run_simplified_tool(2)).pack(anchor="w", pady=2)

        # 3. lbs to kg
        tk.Label(container, text="3. Weight Converter (Pounds to Kilograms)", font=("Arial", 10, "bold"), fg="#003366").pack(anchor="w", pady=(10, 2))
        self.t3_lbs = create_simple_field(container, "Enter Patient Weight:", "lbs")
        self.t3_res = tk.Label(container, text="Result: --", font=("Arial", 9, "bold"), fg="gray"); self.t3_res.pack(anchor="w")
        ttk.Button(container, text="Convert to kg", command=lambda: self.run_simplified_tool(3)).pack(anchor="w", pady=2)

        # 4. basic clark's rule
        tk.Label(container, text="4. Pediatric Weight Dosing (Clark's Rule)", font=("Arial", 10, "bold"), fg="#003366").pack(anchor="w", pady=(10, 2))
        self.t4_w = create_simple_field(container, "Child Weight:", "lbs")
        self.t4_adult = create_simple_field(container, "Standard Adult Dose:", "mg")
        self.t4_res = tk.Label(container, text="Result: --", font=("Arial", 9, "bold"), fg="gray"); self.t4_res.pack(anchor="w")
        ttk.Button(container, text="Calculate Child Dose", command=lambda: self.run_simplified_tool(4)).pack(anchor="w", pady=2)

        # 5. basic gtt/min
        tk.Label(container, text="5. Gravity Tubing Drip Rate Calculator (gtt/min)", font=("Arial", 10, "bold"), fg="#003366").pack(anchor="w", pady=(10, 2))
        self.t5_vol = create_simple_field(container, "Total Infusion Volume:", "mL")
        self.t5_df = create_simple_field(container, "Tubing Drop Factor:", "gtt/mL")
        self.t5_time = create_simple_field(container, "Total Time Window:", "Minutes")
        self.t5_res = tk.Label(container, text="Result: --", font=("Arial", 9, "bold"), fg="gray"); self.t5_res.pack(anchor="w")
        ttk.Button(container, text="Calculate Drip Rate", command=lambda: self.run_simplified_tool(5)).pack(anchor="w", pady=2)

        # 6. f to c
        tk.Label(container, text="6. Temperature Converter (Fahrenheit to Celsius)", font=("Arial", 10, "bold"), fg="#003366").pack(anchor="w", pady=(10, 2))
        self.t6_f = create_simple_field(container, "Enter Temperature:", "°F")
        self.t6_res = tk.Label(container, text="Result: --", font=("Arial", 9, "bold"), fg="gray"); self.t6_res.pack(anchor="w")
        ttk.Button(container, text="Convert to °C", command=lambda: self.run_simplified_tool(6)).pack(anchor="w", pady=2)

        # 7. liquid dosage (Desired / Have * Quantity)
        tk.Label(container, text="7. Liquid Medication Dosage (D / H * Q)", font=("Arial", 10, "bold"), fg="#003366").pack(anchor="w", pady=(10, 2))
        self.t7_d = create_simple_field(container, "Desired Dose Ordered (D):", "mg")
        self.t7_h = create_simple_field(container, "Dose on Hand (H):", "mg")
        self.t7_q = create_simple_field(container, "Volume Unit Quantity (Q):", "mL")
        self.t7_res = tk.Label(container, text="Result: --", font=("Arial", 9, "bold"), fg="gray"); self.t7_res.pack(anchor="w")
        ttk.Button(container, text="Calculate Volume to Give", command=lambda: self.run_simplified_tool(7)).pack(anchor="w", pady=2)

        # 8. basic i&o balance
        tk.Label(container, text="8. Total Intake and Output Balance", font=("Arial", 10, "bold"), fg="#003366").pack(anchor="w", pady=(10, 2))
        self.t8_in = create_simple_field(container, "Total Fluid Intake:", "mL")
        self.t8_out = create_simple_field(container, "Total Fluid Output:", "mL")
        self.t8_res = tk.Label(container, text="Result: --", font=("Arial", 9, "bold"), fg="gray"); self.t8_res.pack(anchor="w")
        ttk.Button(container, text="Calculate Net Balance", command=lambda: self.run_simplified_tool(8)).pack(anchor="w", pady=2)

        # 9. standard body surface area (Mosteller)
        tk.Label(container, text="9. Body Surface Area (BSA) Calculator", font=("Arial", 10, "bold"), fg="#003366").pack(anchor="w", pady=(10, 2))
        self.t9_h = create_simple_field(container, "Patient Height:", "cm")
        self.t9_w = create_simple_field(container, "Patient Weight:", "kg")
        self.t9_res = tk.Label(container, text="Result: --", font=("Arial", 9, "bold"), fg="gray"); self.t9_res.pack(anchor="w")
        ttk.Button(container, text="Calculate BSA", command=lambda: self.run_simplified_tool(9)).pack(anchor="w", pady=2)

        # 10. basic capsule dosage
        tk.Label(container, text="10. Solid Oral Medication Dosage (D / H)", font=("Arial", 10, "bold"), fg="#003366").pack(anchor="w", pady=(10, 2))
        self.t10_d = create_simple_field(container, "Desired Dose Ordered (D):", "mg")
        self.t10_h = create_simple_field(container, "Dose Strength on Hand (H):", "mg")
        self.t10_res = tk.Label(container, text="Result: --", font=("Arial", 9, "bold"), fg="gray"); self.t10_res.pack(anchor="w")
        ttk.Button(container, text="Calculate Tablets/Capsules", command=lambda: self.run_simplified_tool(10)).pack(anchor="w", pady=2)

    def run_simplified_tool(self, tool_id):
        try:
            if tool_id == 1:
                val = float(self.t1_input.get())
                self.t1_res.config(text=f"Output: {round(val * 1000, 2)} mcg", fg="green")
            elif tool_id == 2:
                vol = float(self.t2_vol.get())
                time = float(self.t2_time.get())
                self.t2_res.config(text=f"Output: Set pump to {round(vol / time, 2)} mL/hr", fg="green")
            elif tool_id == 3:
                lbs = float(self.t3_lbs.get())
                self.t3_res.config(text=f"Output: {round(lbs / 2.2, 2)} kg", fg="green")
            elif tool_id == 4:
                w = float(self.t4_w.get())
                adult = float(self.t4_adult.get())
                ans = (w / 150) * adult
                self.t4_res.config(text=f"Output: Recommended child dose is {round(ans, 2)} mg", fg="green")
            elif tool_id == 5:
                v = float(self.t5_vol.get())
                df = float(self.t5_df.get())
                t = float(self.t5_time.get())
                ans = (v * df) / t
                self.t5_res.config(text=f"Output: Drip rate speed is {round(ans, 1)} gtt/min", fg="green")
            elif tool_id == 6:
                f = float(self.t6_f.get())
                ans = (f - 32) * 5 / 9
                self.t6_res.config(text=f"Output: {round(ans, 2)} °C", fg="green")
            elif tool_id == 7:
                d = float(self.t7_d.get())
                h = float(self.t7_h.get())
                q = float(self.t7_q.get())
                ans = (d / h) * q
                self.t7_res.config(text=f"Output: Administer {round(ans, 2)} mL", fg="green")
            elif tool_id == 8:
                i = float(self.t8_in.get())
                o = float(self.t8_out.get())
                self.t8_res.config(text=f"Output: Net Fluid Balance Delta is {round(i - o, 2)} mL", fg="green")
            elif tool_id == 9:
                h = float(self.t9_h.get())
                w = float(self.t9_w.get())
                ans = math.sqrt((h * w) / 3600)
                self.t9_res.config(text=f"Output: Patient BSA is {round(ans, 2)} m²", fg="green")
            elif tool_id == 10:
                d = float(self.t10_d.get())
                h = float(self.t10_h.get())
                ans = d / h
                self.t10_res.config(text=f"Output: Provide {round(ans, 2)} tablet(s)/capsule(s)", fg="green")
        except Exception:
            getattr(self, f"t{tool_id}_res").config(text="⚠️ Error - Please verify numbers are formatted properly!", fg="red")

if __name__ == "__main__":
    root = tk.Tk()
    app = HOSANationalMasteryApp(root)
    root.mainloop()
